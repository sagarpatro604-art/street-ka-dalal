 Q3 will be good quarters from that point of view.","doc_kind":"transcript","url":"https://nsearchives.nseindia.com/corporate/DLF_07082026151631_Letter.pdf","page":4.0,"kind":"extracted"}],"kpis":[{"kpi":"Pre-sales / bookings (Rs cr)","value":657.0,"unit":"Rs cr","doc_kind":"presentation","url":"https://nsearchives.nseindia.com/corporate/DLF_03082026173509_Letter.pdf","page":5},{"kpi":"Collections (Rs cr)","value":2406.0,"unit":"Rs cr","doc_kind":"presentation","url":"https://nsearchives.nseindia.com/corporate/DLF_03082026173509_Letter.pdf","page":5},{"kpi":"Pre-sales / bookings (Rs cr)","value":657.0,"unit":"Rs cr","doc_kind":"transcript","url":"https://nsearchives.nseindia.com/corporate/DLF_07082026151631_Letter.pdf","page":3},{"kpi":"Collections (Rs cr)","value":2406.0,"unit":"Rs cr","doc_kind":"transcript","url":"https://nsearchives.nseindia.com/corporate/DLF_07082026151631_Letter.pdf","page":3}]}},{"q":"FY27Q2","ql":"Q2 FY27","basis":"consolidated","rev":1260.6,"ebitda":23.0,"pat":1301.3,"eps":5.25,"m":1.8,"m_y":-1543.0,"rev_y":-23.3,"rev_q":-1.5,"ebitda_y":-91.9,"pat_y":10.3,"pat_q":63.9,"label":"Mixed","url":"https://nsearchives.nseindia.com/corporate/xbrl/INTEGRATED_FILING_INDAS_1740287_16102026062004_WEB.xml","ev":{"ts":"2026-10-16T17:07:29","src":"NSE announcement"},"docs":[{"k":"call","t":"Analysts/Institutional Investor Meet/Con. Call Updates","u":"https://nsearchives.nseindia.com/corporate/DLF_14102026192415_Letter.pdf","ts":"2026-10-14T19:24"},{"k":"result","t":"Outcome of Board Meeting","u":"https://nsearchives.nseindia.com/corporate/DLF_16102026170503_Letter.pdf","ts":"2026-10-16T17:07"},{"k":"press","t":"Press Release","u":"https://nsearchives.nseindia.com/corporate/DLF_16102026182547_Letter.pdf","ts":"2026-10-16T18:25"},{"k":"call","t":"Analysts/Institutional Investor Meet/Con. Call Updates","u":"https://nsearchives.nseindia.com/corporate/DLF_17102026144217_Letter.pdf","ts":"2026-10-17T14:42"}]}],"fdb":{"eq":[{"qe":"2012-06-30","basis":"consolidate