ress_release_Q1FY27.pdf","ts":"2026-07-18T19:44"},{"k":"presentation","t":"Investor Presentation","u":"https://nsearchives.nseindia.com/corporate/CANFINHOME_20072026131407_Revised_Intimation_Investor_presentation_30_06_2026.pdf","ts":"2026-07-20T13:14"},{"k":"call","t":"Analysts/Institutional Investor Meet/Con. Call Updates","u":"https://nsearchives.nseindia.com/corporate/CANFINHOME_20072026205103_Outcome_Of_Q1_FY27_Earnings_Call.pdf","ts":"2026-07-20T20:51"},{"k":"transcript","t":"Analysts/Institutional Investor Meet/Con. Call Updates","u":"https://nsearchives.nseindia.com/corporate/CANFINHOME_24072026171228_Earnings_Call_Transcript.pdf","ts":"2026-07-24T17:13"}]},{"q":"FY27Q2","ql":"Q2 FY27","basis":"standalone","fin":true,"rev":1130.8,"pat":274.6,"eps":20.62,"rev_y":7.8,"rev_q":3.2,"pat_y":9.2,"pat_q":2.5,"label":"Good","url":"https://nsearchives.nseindia.com/corporate/xbrl/INTEGRATED_FILING_NBFC_INDAS_1735240_09102026082119_WEB.xml","ev":{"ts":"2026-10-09T19:08:20","src":"NSE announcement","day":2.3,"w1":-0.4},"docs":[{"k":"result","t":"Outcome of Board Meeting","u":"https://nsearchives.nseindia.com/corporate/CANFINHOME_09102026190342_SE_Intimation_Outcome_of_Q2_H1_FY27.pdf","ts":"2026-10-09T19:08"},{"k":"press","t":"Press Release","u":"https://nsearchives.nseindia.com/corporate/CANFINHOME_09102026201644_SE_Intimation_press_release_Q2FY27.pdf","ts":"2026-10-09T20:16"},{"k":"presentation","t":"Investor Presentation","u":"https://nsearchives.nseindia.com/corporate/CANFINHOME_09102026232624_SE_Investor_presentation_30092026.pdf","ts":"2026-10-09T23:26"},{"k":"call","t":"Analysts/Institutional Investor Meet/Con. Call Updates","u":"https://nsearchives.nseindia.com/corporate/CANFINHOME_12102026225942_Outcome_Of_Q2_FY27_Earnings_Call.pdf","ts":"2026-10-12T22:59"},{"k":"presentation","t":"Investor Presentation","u":"https://nsearchives.nseindia.com/corporate/CANFINHOME_14102026153217_Revised_Intimation_Investor_presentation.pdf","ts":"2026-10-14T15:32"},{"k":"transcript","t":"Analysts/Institutional Investor Meet/Con. Call Updates","u":"https://nsearchives.nseindia.com/corporate/CANFINHOME_17102026160628_Earnings_Call_Transcript.pdf","ts":"2026-10-17T16:08"}],"cm":{"items":[{"field":"outlook","statement":"The company plans to maintain its emphasis on business expansion, asset quality, profitability, liquidity, and governance.","quote":"Company will continue its thrust on growth, asset quality, profitability and liquidity Unwavering focus on good governance and due diligence No deviation from the fundamental ethos of the company","doc_kind":"presentation","url":"https://nsearchives.nseindia.com/corporate/CANFINHOME_09102026232624_SE_Investor_presentation_30092026.pdf","page":5.0,"kind":"extracted"},{"field":"outlook","statement":"The completed digital infrastructure is expected to help the company accelerate innovation, enhance risk management, and pursue growth.","quote":"The modern technology foundation we have established today will enable us to accelerate innovation, respond more effectively to evolving customer needs, strengthen risk management practices, and pursue growth opportunities with greater confidence and agility.","doc_kind":"presentation","url":"https://nsearchives.nseindia.com/corporate/CANFINHOME_09102026232624_SE_Investor_presentation_30092026.pdf","page":18.0,"kind":"extracted"},{"field":"improved","statement":"The number of female employees grew by 6.67% to 336 as of August 31, 2026.","quote":"In line with this commitment, the number of female employees increased from 315 to 336, representing a 6.67% increase as of 31st August 2026 compared to the previous financial year","doc_kind":"presentation","url":"https://nsearchives.nseindia.com/corporate/CANFINHOME_09102026232624_SE_Investor_presentation_30092026.pdf","page":50.0,"kind":"extracted"},{"field":"deteriorated","statement":"The delinquency pool increased from 8.01% in Q1 FY27 to 8.41% in Q2 FY27.","quote":"Total Delinquency 3,802 3,618 3,375 3,442 3,661 Outstanding 39,657 40,693 42,209 42,961 43,539 % 9.58% 8.89% 7.99% 8.01% 8.41%","doc_kind":"presentation","url":"https://nsearchives.nseindia.com/corporate/CANFINHOME_09102026232624_SE_Investor_presentation_30092026.pdf","page":43.0,"kind":"extracted"},{"field":"debt","statement":"The company's total borrowings stood at Rs 39,077.81 crore at the end of Q2 FY27.","quote":"Particulars Q2 FY27 NCD 5,624.59 CP 2,472.52 Deposit 238.70 NHB 5,568.11 Bank borrowings Repo linked 15,537.44 Special Rate 6,464.76 T bill linked 1,774.90 Gsec linked 1,396.80 Total Borrowings 39,077.81","doc_kind":"presentation","url":"https://nsearchives.nseindia.com/corporate/CANFINHOME_09102026232624_SE_Investor_presentation_30092026.pdf","page":39.0,"kind":"extracted"},{"field":"initiatives","statement":"Can Fin Homes completed Project Tejas, a seven-year digital transformation initiative valued at Rs 297 crore.","quote":"The Company has implemented Project Tejas, a Rs. 297-crore, seven-year enterprise digital transformation programme aimed at enhancing operational efficiency, strengthening governance frameworks, improving data-driven decision-making, and building a secure, scalable, and future-ready technology ecosystem","doc_kind":"presentation","url":"https://nsearchives.nseindia.com/corporate/CANFINHOME_09102026232624_SE_Investor_presentation_30092026.pdf","page":51.0,"kind":"extracted"},{"field":"initiatives","statement":"The company rolled out Can Fin Vishwas, a specialized housing loan offering aimed at marginalized and vulnerable groups.","quote":"The Company introduced Can Fin Vishwas, a housing loan product designed for marginalized and vulnerable groups, with the objective of enhancing financial inclusion and improving access to affordable housing finance for underserved sections of society.","doc_kind":"presentation","url":"https://nsearchives.nseindia.com/corporate/CANFINHOME_09102026232624_SE_Investor_presentation_30092026.pdf","page":50.0,"kind":"extracted"},{"field":"initiatives","statement":"The company launched an outreach campaign called PMAY Lantern Nights to engage with working households in the evenings.","quote":"The Company introduced “PMAY Lantern Nights”, a community outreach initiative under PMAY-U 2.0, leveraging the ‘Golden Hour’ (6:30 p.m. to 9:00 p.m.) to engage with working households and enhance awareness of the Interest Subsidy Scheme","doc_kind":"presentation","url":"https://nsearchives.nseindia.com/corporate/CANFINHOME_09102026232624_SE_Investor_presentation_30092026.pdf","page":51.0,"kind":"extracted"},{"field":"tone","statement":"positive","quote":"The modern technology foundation we have established today will enable us to accelerate innovation, respond more effectively to evolving customer needs, strengthen risk management practices, and pursue growth opportunities with greater confidence and agility.","doc_kind":"presentation","url":"https://nsearchives.nseindia.com/corporate/CANFINHOME_09102026232624_SE_Investor_presentation_30092026.pdf","page":18.0,"kind":"extracted"},{"field":"deteriorated","statement":"The IT migration hit disbursements, which fell to only Rs 2,375 crore in the quarter.","quote":"there has been a major impact, and, as a result, the disbursements for the quarter were at only 2,375, you know, crores.","doc_kind":"concall","url":"https://www.perplexity.ai/finance/CANFINHOME.NS/earnings?eventId=710462","page":1.0,"kind":"extracted"},{"field":"improved","statement":"Prepayments fell in the quarter versus Q1.","quote":"for the full, quarter, it has been, much lower at 15, 7095 as compared to 1857 in Q1 of, this year. So there has been an improvement in the, prepayments.","doc_kind":"concall","url":"https://www.perplexity.ai/finance/CANFINHOME.NS/earnings?eventId=710462","page":2.0,"kind":"extracted"},{"field":"improved","statement":"First-half NPA addition was Rs 35 crore against Rs 40 crore a year earlier.","quote":"last year, our increase in, NPA in the first half was, was about 40 crores as against this in the current year, the six months it has been 35 crores.","doc_kind":"concall","url":"https://www.perplexity.ai/finance/CANFINHOME.NS/earnings?eventId=710462","page":3.0,"kind":"extracted"},{"field":"guidance","statement":"Full-year disbursement guidance of Rs 13,000 crore is retained, with a push in Q3 and Q4.","quote":"So we hold the, guidance of 13,000 crore for disbursement, and, we'll push in Q3 and Q4 to cover up.","doc_kind":"concall","url":"https://www.perplexity.ai/finance/CANFINHOME.NS/earnings?eventId=710462","page":2.0,"kind":"extracted"},{"field":"guidance","statement":"AUM growth guidance for the year stays at 13-14%.","quote":"we hold the same guidance for AUM of 13, 14% closer to 14% in terms of our AUM growth for the year.","doc_kind":"concall","url":"https://www.perplexity.ai/finance/CANFINHOME.NS/earnings?eventId=710462","page":2.0,"kind":"extracted"},{"field":"guidance","statement":"Spread and NIM guidance is 2.75% and 3.75%, against current levels of about 2.8% and 3.8%.","quote":"Our guidance is of 2.75 and 3.75 for spread and NIM, whereas we have been operating around 2.8 and, 3.8.","doc_kind":"concall","url":"https://www.perplexity.ai/finance/CANFINHOME.NS/earnings?eventId=710462","page":2.0,"kind":"extracted"},{"field":"outlook","statement":"FY28 internal plan is about Rs 16,000 crore disbursement and 15%+ AUM growth.","quote":"see next year at least we are internally looking at around 16,000 crore disbursement for FY28. So that should translate to around 15% plus AUM growth for next year","doc_kind":"concall","url":"https://www.perplexity.ai/finance/CANFINHOME.NS/earnings?eventId=710462","page":5.0,"kind":"extracted"},{"field":"demand","statement":"Underlying demand remains robust across geographies despite the IT disruption.","quote":"the demand is there is no issue. we are still seeing a robust demand across all the geographies.","doc_kind":"concall","url":"https://www.perplexity.ai/finance/CANFINHOME.NS/earnings?eventId=710462","page":1.0,"kind":"extracted"},{"field":"demand","statement":"Management does not expect a half-percent rate rise to hurt home loan demand much.","quote":"So, you know, half a percent increase from here is not going to make much of a impact in the terms of the demand","doc_kind":"concall","url":"https://www.perplexity.ai/finance/CANFINHOME.NS/earnings?eventId=710462","page":4.0,"kind":"extracted"},{"field":"pricing","statement":"After the repo hike, lending rates for housing customers were raised by 10 bps from 8 October.","quote":"in terms of the rate hike, as I mentioned, we've already passed on effective 8th of, October, 10 basis point for our housing customers.","doc_kind":"concall","url":"https://www.perplexity.ai/finance/CANFINHOME.NS/earnings?eventId=710462","page":2.0,"kind":"extracted"},{"field":"margins","statement":"Management is confident of protecting spread and NIM through the year.","quote":"So we will continue to protect our spread and NIM, and, we are confident during the year we should be able to maintain that","doc_kind":"concall","url":"https://www.perplexity.ai/finance/CANFINHOME.NS/earnings?eventId=710462","page":2.0,"kind":"extracted"},{"field":"costs","statement":"NHB refinance cost is likely to stay at about 6.6-6.7% on the Rs 1,350 crore sanction.","quote":"So effectively the cost may still be 6.6 to 6.7 only and right now we have got 1,350 crores","doc_kind":"concall","url":"https://www.perplexity.ai/finance/CANFINHOME.NS/earnings?eventId=710462","page":10.0,"kind":"extracted"},{"field":"debt","statement":"The company received a Rs 1,350 crore NHB refinance sanction during the quarter.","quote":"during the quarter, we received in terms of, borrowing side, we received a sanction from NHB for 1,350 crores","doc_kind":"concall","url":"https://www.perplexity.ai/finance/CANFINHOME.NS/earnings?eventId=710462","page":2.0,"kind":"extracted"},{"field":"debt","statement":"About Rs 2,500 crore of undrawn sanctions are available.","quote":"we are having close to 2,500 crores of undrawn sanctions which are also there to support the business","doc_kind":"concall","url":"https://www.perplexity.ai/finance/CANFINHOME.NS/earnings?eventId=710462","page":2.0,"kind":"extracted"},{"field":"debt","statement":"Short-term borrowings fell from about 26-27% of total borrowings to about 12%.","quote":"we had almost about 26, 27% of our total borrowing side was short-term borrowing, which now has come down to around 12%.","doc_kind":"concall","url":"https://www.perplexity.ai/finance/CANFINHOME.NS/earnings?eventId=710462","page":3.0,"kind":"extracted"},{"field":"initiatives","statement":"The IT transformation project has gone fully live across branches.","quote":"the highlight of the quarter for, Can Fin obviously has been that, the entire project pages, which is the IT transformation project, has gone fully live.","doc_kind":"concall","url":"https://www.perplexity.ai/finance/CANFINHOME.NS/earnings?eventId=710462","page":1.0,"kind":"extracted"},{"field":"initiatives","statement":"25 of the 28 planned new branches for the year are already operational.","quote":"As against that, 25 branches have already been, started, and their operational with staffing also in place.","doc_kind":"concall","url":"https://www.perplexity.ai/finance/CANFINHOME.NS/earnings?eventId=710462","page":2.0,"kind":"extracted"},{"field":"initiatives","statement":"The sales team will grow from about 90 to about 150 people, crossing 120 by December.","quote":"we will be able to push our sales team strength from 90 to around 150. In fact by December definitely it will cross 120","doc_kind":"concall","url":"https://www.perplexity.ai/finance/CANFINHOME.NS/earnings?eventId=710462","page":6.0,"kind":"extracted"},{"field":"risks","statement":"Water shortage from poor rains could slow construction activity.","quote":"there is a so if there is a water shortage, of course, it can impact in terms of the construction activity.","doc_kind":"concall","url":"https://www.perplexity.ai/finance/CANFINHOME.NS/earnings?eventId=710462","page":4.0,"kind":"extracted"},{"field":"risks","statement":"New Telangana Section 22 checks stopped some cases at the registration stage.","quote":"we had a lot of cases where, you know, finally when it went for the documentation or registration, the process was stopped","doc_kind":"concall","url":"https://www.perplexity.ai/finance/CANFINHOME.NS/earnings?eventId=710462","page":2.0,"kind":"extracted"},{"field":"tone","statement":"neutral","quote":"I think it's been a quarter where it's been a slightly impacted because of the IT transformation but I think it is in the long term perspective of the company","doc_kind":"concall","url":"https://www.perplexity.ai/finance/CANFINHOME.NS/earnings?eventId=710462","page":10.0,"kind":"extracted"}],"kpis":[{"kpi":"Disbursements (Rs cr)","value":2375.0,"unit":"Rs cr","doc_kind":"concall","url":"https://www.perplexity.ai/finance/CANFINHOME.NS/earnings?eventId=710462","page":1}]}}],"fdb":{"eq":[{"qe":"2012-06-30","basis":"standalone","rev":83.8,"pbt":15.0,"pat":11.5,"eps":5.6,"pub":"2012-08-08"},{"qe":"2012-09-30","basis":"standalone","rev":92.7,"pbt":18.4,"pat":14.4,"eps":7.1,"pub":"2012-10-29"},{"qe":"2012-12-31","basis":"standalone","rev":102.8,"pbt":17.8,"pat":12.6,"eps":6.2,"pub":"2013-01-22"},{"qe":"2013-03-31","basis":"standalone","rev":113.1,"pbt":23.9,"pat":15.5,"eps":7.6,"pub":"2013-04-29"},{"qe":"2013-06-30","basis":"standalone","rev":126.6,"rev_y":50.9,"pbt":24.1,"pat":16.5,"pat_y":43.6,"eps":8.1,"pub":"2013-07-30"},{"qe":"2013-09-30","basis":"standalone","rev":137.9,"rev_y":48.7,"pbt":25.7,"pat":18.7,"pat_y":29.8,"eps":9.1,"pub":"2013-11-05"},{"qe":"2013-12-31","basis":"standalone","rev":151.7,"rev_y":47.5,"pbt":28.9,"pat":20.3,"pat_y":60.9,"eps":9.9,"pub":"2014-02-03"},{"qe":"2014-03-31","basis":"standalone","rev":161.6,"rev_y":42.9,"pbt":27.9,"pat":20.1,"pat_y":29.4,"eps":9.8,"pub":"2014-05-02"},{"qe":"2014-06-30","basis":"standalone","rev":176.0,"rev_y":39.1,"pbt"