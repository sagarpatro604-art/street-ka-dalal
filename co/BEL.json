/corporate/BEL_22052026120346_Letter_signed.pdf","ts":"2026-05-22T12:04"}]},{"q":"FY27Q1","ql":"Q1 FY27","basis":"consolidated","label":"Good","url":"https://nsearchives.nseindia.com/corporate/xbrl/INTEGRATED_FILING_INDAS_1702069_27072026043840_WEB.xml","ev":{"ts":"2026-07-27T16:06:24","src":"NSE announcement","day":-4.5,"w1":0.6,"m1":4.6},"docs":[{"k":"result","t":"Outcome of Board Meeting","u":"https://nsearchives.nseindia.com/corporate/BEL_27072026160426_Lettersigned.pdf","ts":"2026-07-27T16:06"},{"k":"call","t":"Analysts/Institutional Investor Meet/Con. Call Updates","u":"https://nsearchives.nseindia.com/corporate/BEL_27072026213502_Lettersigned.pdf","ts":"2026-07-27T21:35"},{"k":"transcript","t":"Analysts/Institutional Investor Meet/Con. Call Updates","u":"https://nsearchives.nseindia.com/corporate/BEL_28072026140315_Lettersigned.pdf","ts":"2026-07-28T14:03"}],"cm":{"items":[{"field":"improved","statement":"Revenue from operations grew by 25.27% year-on-year to INR 5,533 crores in Q1.","quote":"The revenue from operations has increased to INR5,533 crores up to Q1 as compared to INR4,417 crores in the previous year Q1, with a growth of 25.27 percentage.","doc_kind":"transcript","url":"https://nsearchives.nseindia.com/corporate/BEL_28072026140315_Lettersigned.pdf","page":3.0,"kind":"extracted"},{"field":"improved","statement":"Receivable days dropped from 176 days at the end of March to approximately 140 days as of June 30.","quote":"As far as the receivables are concerned, the number of days as on 30th June, it is around 140 days. It was 176 days as on 31st March. So, it is at 140 days as on 30th June. So, it has improved over March.","doc_kind":"transcript","url":"https://nsearchives.nseindia.com/corporate/BEL_28072026140315_Lettersigned.pdf","page":5.0,"kind":"extracted"},{"field":"improved","statement":"Profit after tax rose 8.17% to INR 1,048 crores in Q1 compared to INR 969 crores in the prior-year period.","quote":"The profit after tax has increased to INR1,048 crores up to Q1 as compared to INR969 crores up to Q1 previous year, with a growth of 8.17%.","doc_kind":"transcript","url":"https://nsearchives.nseindia.com/corporate/BEL_28072026140315_Lettersigned.pdf","page":3.0,"kind":"extracted"},{"field":"outlook","statement":"Management expects order inflows to be evenly distributed across the Army, Navy, and Air Force segments.","quote":"So, again in the year, this INR55,000 also, more or less it will be evenly distributed across Army, Navy, Air Force. So, as such, there is equal priority, I should say, or equal confidence of all the three forces in this.","doc_kind":"transcript","url":"https://nsearchives.nseindia.com/corporate/BEL_28072026140315_Lettersigned.pdf","page":6.0,"kind":"extracted"},{"field":"guidance","statement":"Management reaffirmed its guidance of 28% EBITDA margin for the full year.","quote":"As far as margins are concerned, as we have already told, current year EBITDA margin guidance we have given of 28%, we remain at that.","doc_kind":"transcript","url":"https://nsearchives.nseindia.com/corporate/BEL_28072026140315_Lettersigned.pdf","page":5.0,"kind":"extracted"},{"field":"guidance","statement":"BEL is targeting a full-year order inflow of over INR 55,000 crores, which includes the QRSAM project.","quote":"For us, it is yearly target and which we have already given at the start of the year, the guidance. So, that is INR55,000 plus crores, including QRSAM.","doc_kind":"transcript","url":"https://nsearchives.nseindia.com/corporate/BEL_28072026140315_Lettersigned.pdf","page":5.0,"kind":"extracted"},{"field":"guidance","statement":"The company expects to deliver revenue growth of 15% for the year.","quote":"Definitely, as I told last year also, target is 15%. Last month we may surprise you by maybe 0.5%, 1%, 1.5%. I don't know how much more we can have, but our balanced plan is 15% and I am confident we will reach 15%.","doc_kind":"transcript","url":"https://nsearchives.nseindia.com/corporate/BEL_28072026140315_Lettersigned.pdf","page":19.0,"kind":"extracted"},{"field":"costs","statement":"Employee cost as a percentage of turnover is projected to stay around 12% in the coming years despite an upcoming wage revision.","quote":"As far as the impact is concerned, because the turnover will be increasing year-on-year, as we have already told that we are projecting a good growth in the coming years, we expect the employee cost to turnover to be in the range of around 12% even in the coming years also","doc_kind":"transcript","url":"https://nsearchives.nseindia.com/corporate/BEL_28072026140315_Lettersigned.pdf","page":12.0,"kind":"extracted"},{"field":"costs","statement":"The sequential and annual increase in raw material costs was attributable to product mix rather than input cost pressures.","quote":"We have analysed thoroughly, this particular one and based on the product mix only, the final conclusion was it was because of product mix, it was not because of some pressure because of raw material related consumption or input cost suddenly increase etcetera.","doc_kind":"transcript","url":"https://nsearchives.nseindia.com/corporate/BEL_28072026140315_Lettersigned.pdf","page":20.0,"kind":"extracted"},{"field":"costs","statement":"Other expenses declined due to the absence of liquidated damages provisions that were recognized in the previous year's comparable quarter.","quote":"During the previous year, the provisions relating to the liquidated damages during this current quarter April to June of '22 was on the higher side based on the delivery schedule of those contracts which were executed during the previous year. Due to which current year that is not there. So, that is the difference where the other expenses have come down.","doc_kind":"transcript","url":"https://nsearchives.nseindia.com/corporate/BEL_28072026140315_Lettersigned.pdf","page":10.0,"kind":"extracted"},{"field":"margins","statement":"BEL reported an EBITDA margin of 25.83% for the first quarter of the financial year.","quote":"The EBITDA margin up to Q1 is 25.83%. The earning per share increased to INR1.43 up to Q1 as compared to INR1.33 previous year at the same time.","doc_kind":"transcript","url":"https://nsearchives.nseindia.com/corporate/BEL_28072026140315_Lettersigned.pdf","page":3.0,"kind":"extracted"},{"field":"capex","statement":"The company is investing over INR 1,200 crores in production-related capex and infrastructure enhancements.","quote":"Our main capex is for infrastructure for our what we call production-related activities, capacity enhancement for that. That as we have given you guidance, INR1,200 plus crores we are investing under capex which will take care of our production and other type of investments.","doc_kind":"transcript","url":"https://nsearchives.nseindia.com/corporate/BEL_28072026140315_Lettersigned.pdf","page":13.0,"kind":"extracted"},{"field":"orders","statement":"The company's order book stood at INR 72,258 crores as of July 1, 2026, with Q1 order inflows of INR 3,754 crores.","quote":"The order book position as on 1st July 2026 is INR72,258 crores and orders acquired in this quarter is INR3,754 crores. So, this is the brief financial highlight of Q1 '26-'27 from my side.","doc_kind":"transcript","url":"https://nsearchives.nseindia.com/corporate/BEL_28072026140315_Lettersigned.pdf","page":3.0,"kind":"extracted"},{"field":"orders","statement":"BEL expects around INR 9,000-plus crores in orders from Shatrughat and Samaghat in the next 3 to 6 months.","quote":"So, for Shatrughat and Samaghat, I think I told you around INR9,000 plus crores, we may get from Shatrughat and Samaghat. And about Shakti, it will be around INR2,000 crores. And about HAMMER also it is around INR2,500 plus crores.","doc_kind":"transcript","url":"https://nsearchives.nseindia.com/corporate/BEL_28072026140315_Lettersigned.pdf","page":19.0,"kind":"extracted"},{"field":"debt","statement":"Management noted that receivables and cash flows remain in good condition without significant concerns.","quote":"So, it is at 140 days as on 30th June. So, it has improved over March. So, receivables are good. Cash flows are good. There is not much concern on those front.","doc_kind":"transcript","url":"https://nsearchives.nseindia.com/corporate/BEL_28072026140315_Lettersigned.pdf","page":5.0,"kind":"extracted"},{"field":"initiatives","statement":"BEL plans to eliminate imports of modules and sub-modules over the next five years via an indigenization drive.","quote":"No, the thing is aim is in the next 5 years zero import of any module, sub-module level thing. So, barring components, semiconductor components, all other type of subsystems which we are importing, some of the subsystem at RF, microwave, or SBCs, or something compute, etcetera, we are importing as a module.","doc_kind":"transcript","url":"https://nsearchives.nseindia.com/corporate/BEL_28072026140315_Lettersigned.pdf","page":13.0,"kind":"extracted"},{"field":"initiatives","statement":"BEL is aiming to increase exports to 10% of total revenue over the next five years.","quote":"So, we are confident to slowly and slowly increase our presence in export market because -- as you also remember and I told earlier, we want to finally aim at 10% of our revenues through export. So, we are working systematically to see that we reach that goal in next five years.","doc_kind":"transcript","url":"https://nsearchives.nseindia.com/corporate/BEL_28072026140315_Lettersigned.pdf","page":20.0,"kind":"extracted"},{"field":"tone","statement":"positive","quote":"The revenue growth of 15%, EBITDA margin 21% to 23%, order inflow of more than INR20,000 crores including QRSAM, the R&D investment more than INR2,200 crores, capex more than INR1,200 crores with a typical defence non-defence business of 90:10. So, this guidance definitely we are working towards and I am confident we will achieve this guidance for this financial year.","doc_kind":"transcript","url":"https://nsearchives.nseindia.com/corporate/BEL_28072026140315_Lettersigned.pdf","page":21.0,"kind":"extracted"}],"kpis":[{"kpi":"Order inflow (Rs cr)","value":3754.0,"unit":"INR crores","doc_kind":"transcript","url":"https://nsearchives.nseindia.com/corporate/BEL_28072026140315_Lettersigned.pdf","page":3},{"kpi":"Order book (Rs cr)","value":72258.0,"unit":"INR crores","doc_kind":"transcript","url":"https://nsearchives.nseindia.com/corporate/BEL_28072026140315_Lettersigned.pdf","page":3}]}}],"fdb":{"eq":[{"qe":"2012-06-30","basis":"standalone","rev":779.2,"pbt":26.0,"pat":19.3,"eps":2.42,"pub":"2012-07-30"},{"qe":"2012-09-30","basis":"standalone","rev":1039.9,"pbt":103.4,"pat":80.2,"eps":10.03,"pub":"2012-10-29"},{"qe":"2012-12-31","basis":"standalone","rev":1443.7,"pbt":257.3,"pat":197.6,"eps":24.7,"pub":"2013-01-28"},{"qe":"2013-03-31","basis":"standalone","rev":2727.6,"pbt":727.9,"pat":592.7,"eps":74.09,"pub":"2013-06-13"},{"qe":"2013-06-30","basis":"standalone","rev":884.6,"rev_y":13.5,"pbt":22.4,"pat":17.2,"pat_y":-11.1,"eps":2.15,"pub":"2013-07-26"},{"qe":"2013-09-30","basis":"standalone","rev":1009.3,"rev_y":-2.9,"pbt":76.8,"pat":59.4,"pat_y":-25.9,"eps":7.43,"pub":"2013-10-25"},{"qe":"2013-12-31","basis":"standalone","rev":1172.4,"rev_y":-18.8,"pbt":244.5,"pat":191.7,"pat_y":-3.0,"eps":23.97,"pub":"2014-02-03"},{"qe":"2014-03-31","basis":"standalone","rev":3056.0,"rev_y":12.0,"pbt":831.1,"pat":663.2,"pat_y":11.9,"eps":82.91,"pub":"2014-06-05"},{"qe":"2014-06-30","basis":"standalone","rev":996.7,"rev_y":12.7,"pbt":33.3,"pat":25.6,"pat_y":49.0,"eps":3.2,"pub":"2014-08-11"},{"qe":"2014-09-30","basis":"standalone","rev":1265.7,"rev_y":25.4,"pbt":191.7,"pat":147.0,"pat_y":147.2,"eps":18.37,"pub":"2014-11-12"},{"qe":"2014-12-31","basis":"standalone","rev":1581.7,"rev_y":34.9,"pbt":354.2,"pat":271.8,"pat_y":41.8,"eps":33.98,"pub":"2015-01-27"},{"qe":"2015-03-31","basis":"standalone","rev":2831.4,"rev_y":-7.3,"pbt":887.4,"pat":722.9,"pat_y":9.0,"eps":90.36,"pub":"2015-06-04"}],"bs":[{"end":"2022-09-30","basis"